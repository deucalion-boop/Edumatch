NODE_ENV=development
PORT=5000

JWT_SECRET=replace-with-a-long-random-secret

ADMIN_NAME=EduMatch Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# Used only to create the first administrator. Existing credentials are never reset on startup.
ADMIN_PASSWORD=replace-with-a-strong-password

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0
# Local development may leave Redis blank. Production requires an actual Redis connection.
# Use rediss:// for a hosted TLS Redis endpoint; an HTTPS REST URL is not compatible.
REDIS_URL=
APP_BASE_URL=http://localhost:5173
FRONTEND_DIST_PATH=../frontend/dist

RECAPTCHA_SECRET_KEY=replace-with-your-recaptcha-secret
RECAPTCHA_ALLOWED_HOSTNAMES=localhost

MAIL_API_URL=https://your-mail-api-endpoint.com/mail-api.php
MAIL_API_KEY=replace-with-your-mail-api-key
MAIL_DEFAULT_TO=admin@example.com
MAIL_DEFAULT_TO_NAME=EduMatch Admin
MAIL_DEFAULT_CC=
MAIL_DEFAULT_BCC=

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=files
SUPABASE_STORAGE_PUBLIC=false
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=3600
# Optional separate signing secret; falls back to JWT_SECRET when blank.
STORAGE_URL_SIGNING_SECRET=

AI_PROVIDER=openrouter
AI_MODEL_NAME=meta-llama/llama-3-8b-instruct
AI_API_KEY=replace-with-your-ai-key
AI_BASE_URL=
AI_GENERATOR_ENABLED=true
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
